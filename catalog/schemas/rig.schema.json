{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "measurement_id": {
            "type": "string",
            "minLength": 1
          },
          "placement": {
            "type": "string",
            "enum": [
              "moving",
              "fixed_gimbal",
              "operator"
            ]
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "model_id",
          "measurement_id",
          "placement"
        ]
      }
    }
  },
  "required": [
    "id",
    "components"
  ]
}
