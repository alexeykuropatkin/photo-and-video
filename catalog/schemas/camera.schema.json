{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "common.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "camera"
        },
        "specs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mount_id": {
              "type": "string",
              "minLength": 1
            },
            "sensor": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "format_id": {
                  "type": "string",
                  "minLength": 1
                },
                "width_mm": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "height_mm": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "effective_megapixels": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "shutter_type": {
                  "type": "string",
                  "enum": [
                    "global",
                    "rolling",
                    "hybrid",
                    "unknown"
                  ]
                },
                "readout_ms": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "format_id"
              ]
            },
            "autofocus": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "continuous_supported": {
                  "type": "boolean"
                },
                "subject_tracking_supported": {
                  "type": "boolean"
                },
                "eye_tracking_supported": {
                  "type": "boolean"
                },
                "methods": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "phase",
                      "contrast",
                      "hybrid",
                      "unknown"
                    ]
                  }
                }
              }
            },
            "power": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "native_battery_interface_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "external_inputs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "connector_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "min_voltage_v": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "max_voltage_v": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "nominal_power_w": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      }
                    },
                    "required": [
                      "connector_id"
                    ]
                  }
                }
              }
            },
            "recording_modes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "codec_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "width_px": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "height_px": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "fps": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "bit_depth": {
                    "type": "integer",
                    "minimum": 8,
                    "maximum": 32
                  },
                  "raw": {
                    "type": "boolean"
                  },
                  "chroma_subsampling": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "enum": [
                      "4:2:0",
                      "4:2:2",
                      "4:4:4",
                      null
                    ]
                  },
                  "bitrate_mbps": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "recording": {
                    "type": "string",
                    "enum": [
                      "internal",
                      "external"
                    ]
                  },
                  "sensor_crop_factor": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "gamut_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "gamma_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "note": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "codec_id",
                  "width_px",
                  "height_px",
                  "fps",
                  "bit_depth",
                  "raw",
                  "recording"
                ]
              }
            },
            "physical": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "width_mm": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "height_mm": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "depth_mm": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            "nd_filters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "internal": {
                  "type": "boolean"
                },
                "max_stops": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "media_slots": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "interface_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "interface_id",
                  "count"
                ]
              }
            }
          },
          "required": [
            "mount_id",
            "sensor"
          ]
        }
      },
      "required": [
        "type",
        "specs"
      ]
    }
  ]
}
