{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "common.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "cage"
        },
        "specs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "supported_camera_model_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "physical": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "width_mm": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "height_mm": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "depth_mm": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            "mounting": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "screw_1_4_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "screw_3_8_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "nato_rail": {
                  "type": "boolean"
                },
                "cold_shoes": {
                  "type": "integer",
                  "minimum": 0
                },
                "arri_rosette": {
                  "type": "boolean"
                }
              }
            },
            "port_access": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "hdmi": {
                  "type": "boolean"
                },
                "usb": {
                  "type": "boolean"
                },
                "sd_cards": {
                  "type": "boolean"
                },
                "battery_door": {
                  "type": "boolean"
                }
              }
            },
            "gimbal_clearance": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "tested": {
                  "type": "boolean"
                },
                "notes": {
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "supported_camera_model_ids"
          ]
        }
      },
      "required": [
        "type",
        "specs"
      ]
    }
  ]
}
